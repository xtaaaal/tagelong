
{
  "collectionName": "components_itinerary_days",
  "info": {
    "displayName": "Day",
    "description": "Daily itinerary component"
  },
  "options": {},
  "settings": {
    "mainField": "subtitle"
  },
  "attributes": {
    "dayNumber": {
      "type": "integer",
      "min": 1,
      "required": false
    },
    "subtitle": {
      "type": "string",
      "maxLength": 255
    },
    "picture": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"],
      "maxFiles": 10
    },
    "content": {
      "type": "richtext",
      "required": false
    },
    "googleMapsLink": {
      "type": "string",
      "required": false,
      "multiple": true
    },
    "youtubeLink": {
      "type": "string",
      "required": false,
      "multiple": true
    },
    "showDistanceFromLastStop": {
      "type": "boolean",
      "default": false
    },
    "fileUpload": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    }
  }
}